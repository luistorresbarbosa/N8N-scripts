{
  "name": "Daily Gmail Invoice Orchestration",
  "nodes": [
    {
      "parameters": {
        "triggerTimes": [
          {
            "hour": 1,
            "minute": 0
          }
        ]
      },
      "id": "Cron_Trigger",
      "name": "Daily Schedule",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "functionCode": "const suppliers = [\n  { name: 'Northwind', tag: 'supplier/northwind', email: 'billing@northwind.com' },\n  { name: 'Contoso', tag: 'supplier/contoso', email: 'ap@contoso.com' },\n  { name: 'Globex', tag: 'supplier/globex', email: 'finance@globex.example' }\n];\n\nconst queryParts = suppliers.map((supplier) => {\n  const filters = [`label:${supplier.tag}`, `from:${supplier.email}`];\n  return `(${filters.join(' OR ')})`;\n});\n\nconst gmailQuery = `${queryParts.join(' OR ')} has:attachment filename:pdf`;\n\nreturn [\n  {\n    json: {\n      suppliers,\n      gmailQuery,\n      runId: $execution.id\n    }\n  }\n];"
      },
      "id": "Function_Build_Query",
      "name": "Build Supplier Query",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "gmailCredential",
              "value": "Gmail Account A"
            },
            {
              "name": "gmailAccountLabel",
              "value": "primary"
            }
          ]
        },
        "options": {}
      },
      "id": "Set_Account_A",
      "name": "Select Account A",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        460,
        140
      ]
    },
    {
      "parameters": {
