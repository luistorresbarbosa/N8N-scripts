    {
      "parameters": {
        "mode": "append"
      },
      "id": "Merge_Accounts",
      "name": "Merge Accounts",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "functionCode": "const flattened = [];\nfor (const item of items) {\n  const binaryKeys = Object.keys(item.binary || {});\n  if (!binaryKeys.length) {\n    continue;\n  }\n\n  for (const key of binaryKeys) {\n    const attachment = item.binary[key];\n    if (!attachment || attachment.fileExtension?.toLowerCase() !== 'pdf') {\n      continue;\n    }\n\n    flattened.push({\n      json: {\n        supplierHint: item.json.from?.value?.[0]?.address || null,\n        gmailAccount: item.json.gmailAccount || null,\n        messageId: item.json.id,\n        threadId: item.json.threadId,\n        subject: item.json.subject,\n        historyId: item.json.historyId,\n        runId: item.json.runId || null\n      },\n      binary: {\n        data: attachment\n      }\n    });\n  }\n}\nreturn flattened;"
      },
      "id": "Function_Flatten_Attachments",
      "name": "Flatten Attachments",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1360,
        300
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "runId",
              "value": "={{$json.runId || $execution.id}}"
            }
          ]
        },
        "options": {}
      },
      "id": "Set_Run_Metadata",
      "name": "Set Run Metadata",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        1600,
        420
      ]
    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "={{$env.AI_AGENT_URL || 'https://api.example.com/invoices:extract'}}",
        "sendBinaryData": true,
        "binaryPropertyName": "data",
        "jsonParameters": true,
        "options": {
          "bodyContentType": "json",
          "responseFormat": "json"
        },
        "bodyParametersJson": "={\"supplier_hint\": $json.supplierHint, \"message_id\": $json.messageId, \"gmail_account\": $json.gmailAccount, \"subject\": $json.subject, \"run_id\": $json.runId}"
      },
      "id": "HTTP_AI_Agent",
      "name": "Send to AI Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        1600,
        180
      ],
      "credentials": {
        "httpBasicAuth": "AI Agent Credentials"
      }
    },
    {
      "parameters": {
        "mode": "mergeByIndex"
      },
      "id": "Merge_AI_and_Metadata",
      "name": "Merge AI Response",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [
        1840,
        300
      ]
    },
    {
      "parameters": {
        "functionCode": "const projectId = $env.FIREBASE_PROJECT_ID || 'your-project-id';\nconst collectionPath = `projects/${projectId}/databases/(default)/documents/invoiceHistory`;\n\nreturn items.map(item => ({\n  json: {\n    firestoreEndpoint: `https://firestore.googleapis.com/v1/${collectionPath}?documentId=${encodeURIComponent(item.json.message_id || item.json.messageId)}`,\n    payload: {\n      fields: {\n        messageId: { stringValue: item.json.message_id || item.json.messageId },\n        gmailAccount: { stringValue: item.json.gmail_account || item.json.gmailAccount || '' },\n        supplierHint: { stringValue: item.json.supplier_hint || item.json.supplierHint || '' },\n        subject: { stringValue: item.json.subject || '' },\n        runId: { stringValue: item.json.run_id || item.json.runId || '' },\n        processedAt: { timestampValue: new Date().toISOString() },\n        aiExtraction: { mapValue: { fields: Object.fromEntries(Object.entries(item.json).filter(([key]) => !['message_id','messageId','gmail_account','gmailAccount','supplier_hint','supplierHint','subject','run_id','runId','firestoreEndpoint','payload'].includes(key)).map(([key, value]) => ([key, { stringValue: typeof value === 'string' ? value : JSON.stringify(value) }])) ) } }\n      }\n    }\n  }\n}));"
      },
      "id": "Function_Prepare_Firebase",
      "name": "Prepare Firebase Payload",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        2080,
        300
      ]
    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "={{$json.firestoreEndpoint}}",
        "jsonParameters": true,
        "bodyParametersJson": "={{$json.payload}}",
        "options": {
          "bodyContentType": "json"
        },
        "headerParametersJson": "={\"Authorization\": \"Bearer {{$env.FIREBASE_BEARER_TOKEN}}\"}"
      },
      "id": "HTTP_Firebase",
      "name": "Store in Firebase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        2320,
        300
      ]
    }
  ],
